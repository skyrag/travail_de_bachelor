# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index(request : Request)

GET     /login                      controllers.HomeController.login(request : Request)
POST    /login                      controllers.HomeController.authenticate(request : Request)

GET     /register                   controllers.HomeController.register(request : Request)
POST    /register                   controllers.HomeController.registerIn(request : Request)

GET     /ws                        controllers.HomeController.webSocket()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
